{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisArchive Profile",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "profile_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seed_urls": {
          "type": "object",
          "properties": {
            "tier_1_core": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tier_2_breadth": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tier_3_discovery": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "tier_1_core"
          ]
        },
        "path_whitelist_regex": {
          "type": "string"
        },
        "path_blacklist_regex": {
          "type": "string"
        },
        "asset_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 5
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 5000
        }
      },
      "required": [
        "allowed_domains",
        "seed_urls"
      ]
    },
    "politeness": {
      "type": "object",
      "properties": {
        "min_delay_ms": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000,
          "default": 1200
        },
        "max_delay_ms": {
          "type": "integer",
          "minimum": 250,
          "maximum": 120000,
          "default": 3500
        },
        "jitter_distribution": {
          "type": "string",
          "enum": [
            "gaussian",
            "uniform"
          ],
          "default": "gaussian"
        },
        "max_requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 30
        },
        "concurrency": {
          "type": "integer",
          "maximum": 1,
          "deprecated": true,
          "description": "Deprecated and ignored: the engine is single-flight by design.",
          "minimum": 1,
          "default": 1
        },
        "burst_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "respect_retry_after": {
          "type": "boolean",
          "default": true
        },
        "adaptive_ewma_backoff": {
          "type": "boolean",
          "default": true
        },
        "consecutive_error_tripwire": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600,
          "default": 60
        },
        "robots_policy": {
          "type": "string",
          "enum": [
            "respect",
            "ignore_authorised"
          ],
          "default": "respect",
          "description": "respect: fetch /robots.txt once per origin and honour Disallow; ignore_authorised: skip robots.txt only for targets you are explicitly authorised to archive (decision is written to the audit ledger)."
        }
      }
    },
    "archival": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string",
          "default": "AegisArchive Operator"
        },
        "organization": {
          "type": "string",
          "default": "Digital Preservation Research"
        },
        "warc_prefix": {
          "type": "string",
          "default": "aegis_archive"
        },
        "deduplicate_payloads": {
          "type": "boolean",
          "default": true
        },
        "generate_cdx": {
          "type": "boolean",
          "default": true
        },
        "enable_opfs_streaming": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "label",
          "keywords"
        ]
      }
    }
  },
  "required": [
    "profile_id",
    "profile_name",
    "target",
    "politeness"
  ],
  "additionalProperties": false
}